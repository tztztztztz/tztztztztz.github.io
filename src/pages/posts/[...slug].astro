---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../../components/Layout.astro";
import { formatDate, getPosts, readingTime, withBase } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.date}>
  <article class="article wrap">
    <header class="article-head">
      <h1>{post.data.title}</h1><p class="lead">{post.data.description}</p>
      <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>约 {readingTime(post.body)} 分钟阅读</span></div>
    </header>
    <div class="prose"><Content /></div>
    <div class="article-end"><a href={withBase("/")}>返回首页</a></div>
  </article>
</Layout>
